{
  "info": { "name": "interview-demo API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/health" } }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/users/login" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\": \"admin@demo.com\", \"password\": \"secret\"}" }
      }
    },
    {
      "name": "Get All Users (Auth required)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/api/users" },
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    }
  ]
}
